# Copy to .env.local. All values are optional; nothing here is a secret.

# Where "Domain for Sale" / "View Domain Details" / "Make an Inquiry" links point
# (marketplace listing, contact form, etc.). If empty, the banner and CTAs route to /domain.
NEXT_PUBLIC_DOMAIN_SALE_URL=

# GA4 measurement ID, e.g. G-XXXXXXXXXX. GA4 only loads when this is set.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (the content="" value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
